{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Code Review (Multi-Agent)",
      "type": "shell",
      "command": "python3",
      "args": [
        "${home}/.openclaw/workspace/scripts/code-review-multi-agent.py",
        "${file}",
        "--multi-agent"
